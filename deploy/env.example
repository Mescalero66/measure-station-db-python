# Secrets and per-device overrides for the Measure Station server.
# Installed to /etc/measure-station-db/env (mode 0640, readable by the services only).
# Any MEASURE_STATION_DB_* variable read in sysconfig.py can be set here.
# Passwords: letters, digits, - and _ only. No spaces around the =, and no quotes.

# The broker password of measure-station-db (docs/setting-up-the-server-pi.md, Step 6):
MEASURE_STATION_DB_MQTT_PASSWORD=
# The database password of ingest (docs/setting-up-the-server-pi.md, Step 7):
MEASURE_STATION_DB_DATABASE_PASSWORD=
