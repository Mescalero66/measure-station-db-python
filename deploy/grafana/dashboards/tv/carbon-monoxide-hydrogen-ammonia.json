      "targets": [
        {
          "dataset": "measure_station_db",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "measure-station-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- Carbon monoxide, hydrogen and ammonia (MQ7, MQ8, MQ135), in ppm.\nSELECT v.ts AS time,\n       f.label AS metric,\n       v.num_value AS value\nFROM reading_value v\nJOIN (VALUES\n        ('mqboard-mq7',   'Carbon Monoxide (MQ7)'),\n        ('mqboard-mq8',   'Hydrogen (MQ8)'),\n        ('mqboard-mq135', 'Ammonia (MQ135)')) AS f(source, label)\n  ON f.source = v.source\nWHERE $__timeFilter(v.ts)\n  AND v.station = 'mstn-2b'\n  AND v.section = 'values' AND v.key = 'concentration_ppm'\n  AND v.ts_src <> 'estimated'\nORDER BY v.ts",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
              "Ammonia (MQ135)": 6,
              "Carbon Monoxide (MQ7)": 4,
              "Hydrogen (MQ8)": 5,
              "LPG (MQ5)": 3,
              "Methane (MQ4)": 2,
              "Smoke (MQ2)": 1,
              "Time": 0
            },
            "renameByName": {
              "Ammonia (MQ135)": "Ammonia",
              "Carbon Monoxide (MQ7)": "Carbon Monoxide",
              "Hydrogen (MQ8)": "Hydrogen",
              "LPG (MQ5)": "LPG",
              "Methane (MQ4)": "Methane",
              "Smoke (MQ2)": "Smoke"
            }
          }
        }
      ],
      "type": "stat"
    },
