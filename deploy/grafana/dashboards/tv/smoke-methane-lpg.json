          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- The MQ gas sensors, in ppm.\r\nSELECT v.ts AS time,\r\n       f.label AS metric,\r\n       v.num_value AS value\r\nFROM reading_value v\r\nJOIN (VALUES\r\n        ('mqboard-mq2', 'Smoke (MQ2)'),\r\n        ('mqboard-mq4', 'Methane (MQ4)'),\r\n        ('mqboard-mq5', 'LPG (MQ5)')) AS f(source, label)\r\n  ON f.source = v.source\r\nWHERE $__timeFilter(v.ts)\r\n  AND v.station = 'mstn-2b'\r\n  AND v.section = 'values' AND v.key = 'concentration_ppm'\r\n  AND v.ts_src <> 'estimated'\r\nORDER BY v.ts",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
              "Ammonia (MQ135)": 6,
              "Carbon Monoxide (MQ7)": 4,
              "Hydrogen (MQ8)": 5,
              "LPG (MQ5)": 3,
              "Methane (MQ4)": 2,
              "Smoke (MQ2)": 1,
              "Time": 0
            },
            "renameByName": {
              "Ammonia (MQ135)": "Ammonia",
              "Carbon Monoxide (MQ7)": "Carbon Monoxide",
              "Hydrogen (MQ8)": "Hydrogen",
              "LPG (MQ5)": "LPG",
              "Methane (MQ4)": "Methane",
              "Smoke (MQ2)": "Smoke"
            }
          }
        }
      ],
      "type": "stat"
    },
