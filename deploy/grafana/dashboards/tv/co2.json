            "uid": "measure-station-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- How the last 24 hours' average CO2 compares with the periods before it,\r\n-- shown as a signed difference only: \"+23 ppm\", \"-8 ppm\".\r\nWITH series AS (\r\n  SELECT bucket, avg_value, n\r\n  FROM value_hourly\r\n  WHERE station = 'mstn-2b' AND section = 'values'\r\n    AND source = 'co2' AND key = 'co2_ppm'\r\n    AND bucket >= now() - INTERVAL '1 year 1 day'\r\n),\r\nlast_day AS (\r\n  SELECT sum(avg_value * n) / sum(n) AS avg\r\n  FROM series\r\n  WHERE bucket >= now() - INTERVAL '24 hours'\r\n),\r\ncompared AS (\r\n  SELECT p.ord,\r\n         CASE WHEN count(s.bucket) >= 24\r\n              THEN (SELECT avg FROM last_day) - sum(s.avg_value * s.n) / sum(s.n)\r\n         END AS difference\r\n  FROM (VALUES\r\n          (1, INTERVAL '3 days')) AS p(ord, span)\r\n  LEFT JOIN series s\r\n    ON s.bucket >= now() - INTERVAL '24 hours' - p.span\r\n   AND s.bucket <  now() - INTERVAL '24 hours'\r\n  GROUP BY p.ord\r\n)\r\nSELECT coalesce(to_char(difference, 'FMSG9990') || ' ppm', 'no data') AS shown,\r\n       difference\r\nFROM compared\r\nORDER BY ord",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "3 Day",
      "type": "stat"
    },
