          "rawSql": "-- How the last 24 hours' average CO2 compares with the periods before it,\r\n-- shown as a signed difference only: \"+23 ppm\", \"-8 ppm\".\r\nWITH series AS (\r\n  SELECT\r\n    bucket,\r\n    avg_value,\r\n    n\r\n  FROM\r\n    value_hourly\r\n  WHERE\r\n    station = 'mstn-2b'\r\n    AND section = 'values'\r\n    AND source = 'co2'\r\n    AND key = 'co2_ppm'\r\n    AND bucket >= now() - INTERVAL '1 year 1 day'\r\n),\r\nlast_day AS (\r\n  SELECT\r\n    sum(avg_value * n) / sum(n) AS avg\r\n  FROM\r\n    series\r\n  WHERE\r\n    bucket >= now() - INTERVAL '24 hours'\r\n),\r\ncompared AS (\r\n  SELECT\r\n    p.ord,\r\n    CASE\r\n      WHEN count(s.bucket) >= 24 THEN (\r\n        SELECT\r\n          avg\r\n        FROM\r\n          last_day\r\n      ) - sum(s.avg_value * s.n) / sum(s.n)\r\n    END AS difference\r\n  FROM\r\n    (\r\n      VALUES\r\n        (4, INTERVAL '1 month')\r\n    ) AS p(ord, span)\r\n    LEFT JOIN series s ON s.bucket >= now() - INTERVAL '24 hours' - p.span\r\n    AND s.bucket < now() - INTERVAL '24 hours'\r\n  GROUP BY\r\n    p.ord\r\n)\r\nSELECT\r\n  coalesce(\r\n    to_char(difference, 'FMSG9990') || ' ppm',\r\n    'no data'\r\n  ) AS shown,\r\n  difference\r\nFROM\r\n  compared\r\nORDER BY\r\n  ord",
