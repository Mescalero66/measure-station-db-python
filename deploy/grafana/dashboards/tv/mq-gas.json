        {
          "dataset": "measure_station_db",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "measure-station-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- The six MQ gas sensors, each as a multiple of its clean-air reading (1 = clean air).\r\nSELECT v.ts AS time,\r\n       f.label AS metric,\r\n       v.num_value / f.clean_ppm::float8 AS value\r\nFROM reading_value v\r\nJOIN (VALUES\r\n        ('mqboard-mq2',   'Smoke (MQ2)',       13.0),\r\n        ('mqboard-mq4',   'Methane (MQ4)',     16.0),\r\n        ('mqboard-mq5',   'LPG (MQ5)',          0.85)) AS f(source, label, clean_ppm)\r\n  ON f.source = v.source\r\nWHERE $__timeFilter(v.ts)\r\n  AND v.station = 'mstn-2b'\r\n  AND v.section = 'values' AND v.key = 'concentration_ppm'\r\n  AND v.ts_src <> 'estimated'\r\nORDER BY v.ts",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
