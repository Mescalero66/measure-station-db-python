          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- The latest air quality index (1 excellent ... 5 unhealthy; 0 when the sensor is stuck).\r\n-- Nothing is shown if there's been no reading in the last 15 minutes.\r\nSELECT ts AS time,\r\n       (values_json->>'aqi')::int AS aqi\r\nFROM reading\r\nWHERE station = 'mstn-2b' AND source = 'air-quality'\r\n  AND ts > now() - INTERVAL '15 minutes'\r\nORDER BY ts DESC\r\nLIMIT 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Air Quality Index",
      "type": "stat"
    },
