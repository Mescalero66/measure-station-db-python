#!/bin/sh
# measure-station-db-backup: the backup tool, run by hand (docs/backups.md).
# Installed to /usr/local/bin by deploy/install.sh (@APP_DIR@ and @APP_USER@ are
# substituted). It runs as the backup service does: as the service user, with the
# passwords from /etc/measure-station-db/env.
#
#     sudo measure-station-db-backup init
#     sudo measure-station-db-backup restic snapshots
set -eu
if [ "$(id -u)" -ne 0 ]; then
    echo "Run it with sudo: sudo measure-station-db-backup $*" >&2
    exit 1
fi
set -a
. /etc/measure-station-db/env
set +a
cd /
exec runuser -u @APP_USER@ -- @APP_DIR@/.venv/bin/python -m measure_station_db.backup "$@"
